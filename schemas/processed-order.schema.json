{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProcessedOrderEvent",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "processingStatus": {
      "type": "string",
      "enum": ["PROCESSED"]
    }
  },
  "required": [
    "orderId",
    "product",
    "quantity",
    "processingStatus"
  ],
  "additionalProperties": false
}